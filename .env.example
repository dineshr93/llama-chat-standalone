# Where the webapp listens
PORT=8080
HOST=0.0.0.0

# Any OpenAI-compatible server. llama.cpp, vLLM, LM Studio, Ollama, ...
# host.docker.internal reaches the host from inside the container; use
# http://127.0.0.1:8888 when running the server directly with `make start`.
UPSTREAM=http://host.docker.internal:8888

# Model id the UI sends in requests
MODEL_ID=local-model

# Context window reported to the UI (used for the context meter)
N_CTX=68192

# Optional: Jinja chat template shown in the UI. Empty means the server decides.
CHAT_TEMPLATE=

# Optional: comma separated modalities the model supports, e.g. vision,audio,video
MODALITIES=

# Optional: bearer token added to proxied requests when the client sends none
API_KEY=
